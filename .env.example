# Telegram bot authentication token (required)
TELEGRAM_BOT_TOKEN=

# IANA timezone for interpreting user times and daily sheet boundaries (required)
BABY_LOG_TIMEZONE=Asia/Nicosia

# Path to Google Service Account JSON credentials file (required)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# Google Spreadsheet ID (required)
GOOGLE_SPREADSHEET_ID=